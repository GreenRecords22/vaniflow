# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# IntelliJ / Android Studio
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches

# Keystore files
*.jks
*.keystore

# Signing config (contains keystore passwords - local only, never commit)
keystore.properties

# External native build folder
.cxx/

# Google Services (contains API keys)
google-services.json

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
.env
*.env
local.properties
