# VaniFlow AI Gateway Environment Variables

PORT=8080
NODE_ENV=development
VANIFLOW_APP_ID=com.vaniflow.app

# Primary Cloud Provider: Groq (Recommended: Fast LPU inference)
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_MODEL=llama-3.1-8b-instant

# Secondary / Fallback Cloud Provider: Google Gemini
# Obtain your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
